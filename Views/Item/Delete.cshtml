@model IINVT.Models.Item

@{
    ViewData["Title"] = "Delete";
}


<body>
    <div>

        <h4>Item Information</h4>

        <hr /> 

        <div class="container mt-4">

            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white">
                    <h3>
                        <i class="fas fa-trash-alt"></i>
                        Delete Item
                    </h3>
                </div>

                <div class="card-body">

                    <table class="table table-bordered table-hover">

                        <tr>
                            <th width="25%">Item ID</th>
                            <td>@Model.ItemID</td>
                        </tr>

                        <tr>
                            <th>Item Name</th>
                            <td>@Model.Itemname</td>
                        </tr>

                        <tr>
                            <th>Category</th>
                            <td>
                                <span class="badge bg-primary">
                                    @Model.CategoryName
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Sub Category Name</th>
                            <td>
                                <span class="badge bg-success">
                                    @Model.SubCategoryName
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Code</th>
                            <td>@Model.Code</td>
                        </tr>

                        <tr>
                            <th>Description</th>
                            <td>@Model.Description</td>
                        </tr>

                    </table>

                    <form asp-action="Delete" method="post" onsubmit="return confirm('Are You Sure ? You Want to Delete this Record !');">
                       
                        <input type="hidden" asp-for="ItemID" />

                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i>
                            Delete
                        </button>

                        <a asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-arrow-left"></i>
                            Back to List
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>
</body>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire("Success!", "@TempData["Success"]", "success");
    </script>
}