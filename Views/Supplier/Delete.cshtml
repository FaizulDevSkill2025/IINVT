@model IINVT.Models.Supplier

@{
    ViewData["Title"] = "Delete";
}


<body>
    <div>

        <h4>Supplier Information</h4>

        <hr />

        <div class="container mt-4">

            <div class="card shadow-lg border-0">
                <div class="card-header bg-danger text-white">
                    <h3>
                        <i class="fas fa-trash-alt"></i>
                        Delete Supplier
                    </h3>
                </div>

                <div class="card-body">

                    <table class="table table-bordered table-hover">

                        <tr>
                            <th width="25%">Supplier ID</th>
                            <td>@Model.SupplierID</td>
                        </tr>

                        <tr>
                            <th>Supplier Code</th>
                            <td>@Model.Code</td>
                        </tr>

                        <tr>
                            <th>Supplier Name</th>
                            <td>
                                <span class="badge bg-primary">
                                    @Model.Name
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Supplier Type</th>
                            <td>
                                <span class="badge bg-success">
                                    @Model.Type
                                </span>
                            </td>
                        </tr>

                        <tr>
                            <th>Supplier Address</th>
                            <td>@Model.Address</td>
                        </tr>

                        <tr>
                            <th>Supplier Phone</th>
                            <td>@Model.Phone</td>
                        </tr>

                        <tr>
                            <th>Supplier Email</th>
                            <td>@Model.Email</td>
                        </tr>

                    </table>

                    <form asp-action="Delete" method="post" onsubmit="return confirm('Are You Sure ? You Want to Delete this Record !');">

                        <input type="hidden" asp-for="SupplierID" />

                        <button type="submit" class="btn btn-danger">
                            <i class="fas fa-trash"></i>
                            Delete
                        </button>

                        <a asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-arrow-left"></i>
                            Back to List
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>
</body>

@if (TempData["Success"] != null)
{
    <script>
        Swal.fire("Success!", "@TempData["Success"]", "success");
    </script>
}